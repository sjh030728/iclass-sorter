{
  "manifest_version": 3,
  "name": "I-class 강의자료 자동 분류",
  "version": "1.0.4",
  "description": "인하대 I-class(learn.inha.ac.kr)에서 받은 강의자료를 과목별 폴더에 자동 저장합니다. (비공식)",
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://learn.inha.ac.kr/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://learn.inha.ac.kr/*"
      ],
      "js": [
        "common.js",
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "action": {
    "default_title": "I-class 자동 분류 설정",
    "default_icon": {
      "16": "icons/16.png",
      "48": "icons/48.png"
    }
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}